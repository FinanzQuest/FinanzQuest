{
	servers {
		# Behind the host Caddy, set CADDY_TRUSTED_PROXIES=private_ranges
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
	}
}

{$CADDY_HOST} {
	# 10MB upload limit
    request_body {
  		max_size 10MB
   	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1

		# GoTrue rate-limits guest sign-ins by this header. Only set it on
		# POST /signup (to the real client IP); strip anything the client sent.
		@signup {
			method POST
			path /signup
		}
		handle @signup {
			reverse_proxy auth:9999 {
				header_up X-Signup-Client-Ip {client_ip}
			}
		}
		handle {
			reverse_proxy auth:9999 {
				header_up -X-Signup-Client-Ip
			}
		}
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}

	# Frontend (catch-all)
	handle {
		reverse_proxy frontend:3000 {
			fail_duration 5s
		}
	}
}

